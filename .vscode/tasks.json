// VS Code·Cursor 공용 작업(팀 공용, 커밋 대상). 명령 팔레트 > "Tasks: Run Task"로 실행한다.
// - "HMG: 개발환경 세팅"은 폴더를 열 때 자동 실행된다(runOptions.runOn: folderOpen). Claude Code·Codex SessionStart 훅과 같은 scripts/setup.sh 기본 모드.
//   VS Code는 처음 1회 작업 영역 신뢰 + "자동 작업 허용"이 필요하다(README 2.2). 자동 기동을 끄려면 VS Code를 HMG_AUTOSTART=0 환경에서 연다.
// - 모든 명령은 bash로 실행한다(scripts/*.sh가 bash 전용). Gradle 작업은 JAVA_HOME이 없으면 scripts/_common.sh의 find_java_home으로 JDK 17+를 찾는다.
// 문서: https://code.visualstudio.com/docs/debugtest/tasks
{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "shell": {
      "executable": "bash",
      "args": [
        "-c"
      ]
    }
  },
  "tasks": [
    {
      "label": "HMG: 개발환경 세팅 (점검 + 자동 기동)",
      "detail": "scripts/setup.sh — 점검 후 에뮬레이터·백엔드 백그라운드 기동(이미 실행 중이면 건너뜀). 폴더 열 때 자동 실행",
      "type": "shell",
      "command": "bash scripts/setup.sh",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "HMG: 개발환경 점검 (--check)",
      "detail": "scripts/setup.sh --check — 점검만(파일 생성·자동 기동 없음)",
      "type": "shell",
      "command": "bash scripts/setup.sh --check",
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "HMG: 앱 설치·실행",
      "detail": "scripts/run-app.sh — :frontend:app:installDebug 후 am start",
      "type": "shell",
      "command": "bash scripts/run-app.sh",
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "HMG: 백엔드 실행 (bootRun :8081)",
      "detail": "./gradlew :backend:bootRun — setup.sh가 이미 띄웠으면 포트가 겹친다. 먼저 'HMG: 백엔드 중지'",
      "type": "shell",
      "command": "[ -n \"$JAVA_HOME\" ] || export JAVA_HOME=\"$(source scripts/_common.sh && find_java_home)\"; ./gradlew :backend:bootRun",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "HMG: 백엔드 중지",
      "detail": "scripts/dev-down.sh — setup.sh가 띄운 백엔드(포트 8081의 이 레포 backend) 중지",
      "type": "shell",
      "command": "bash scripts/dev-down.sh",
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "HMG: 에뮬레이터 실행",
      "detail": "scripts/pleos-emu.sh --wait — Cold boot + 부팅 대기(이미 실행 중이면 안내만)",
      "type": "shell",
      "command": "bash scripts/pleos-emu.sh --wait",
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "HMG: Virtual Console",
      "detail": "scripts/pleos-console.sh — adb forward 8088 + 브라우저",
      "type": "shell",
      "command": "bash scripts/pleos-console.sh",
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "HMG: 화면 캡처",
      "detail": "scripts/screenshot.sh — .dev/screenshots/(git 제외)에 PNG 저장",
      "type": "shell",
      "command": "bash scripts/screenshot.sh \".dev/screenshots/screen-$(date +%Y%m%d-%H%M%S).png\"",
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "HMG: 전체 빌드",
      "detail": "./gradlew :frontend:app:assembleDebug :backend:build :shared:build",
      "type": "shell",
      "command": "[ -n \"$JAVA_HOME\" ] || export JAVA_HOME=\"$(source scripts/_common.sh && find_java_home)\"; ./gradlew :frontend:app:assembleDebug :backend:build :shared:build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "HMG: 전체 테스트",
      "detail": "./gradlew :shared:test :backend:test :frontend:app:testDebugUnitTest",
      "type": "shell",
      "command": "[ -n \"$JAVA_HOME\" ] || export JAVA_HOME=\"$(source scripts/_common.sh && find_java_home)\"; ./gradlew :shared:test :backend:test :frontend:app:testDebugUnitTest",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
